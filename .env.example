# Copy to .env and fill in. EXPO_PUBLIC_ prefix is required for Expo to
# inline the value into the client bundle (see src/lib/api.ts).
#
# 127.0.0.1 / localhost will NOT work from a physical device or most
# emulators — they resolve to the device itself, not your dev machine.
# Use your machine's LAN IP instead (ipconfig -> IPv4 Address), e.g.
# http://192.168.1.23:8000/api/v1
#
# Android emulator (not a physical device) can reach the host machine via
# the special alias 10.0.2.2 instead of a LAN IP:
# http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.23:8000/api/v1

# Same host as the API, without the /api/v1 suffix — used for the WebView
# payment/verification flows and for Reverb.
EXPO_PUBLIC_WEB_URL=http://192.168.1.23:8000

# Must match REVERB_APP_KEY in the Laravel .env.
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=192.168.1.23
EXPO_PUBLIC_REVERB_PORT=8080
